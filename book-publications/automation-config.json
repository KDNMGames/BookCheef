{
  "version": 1,
  "timezone": "Europe/Berlin",
  "provider_quota": {
    "enabled_by_actions_variable": "BOOKCHEEF_SHARED_QUOTA_ENABLED",
    "min_interval_seconds": 15,
    "window_seconds": 86400,
    "max_requests_per_window": 0,
    "max_concurrent_per_provider": 1,
    "reservation_lease_seconds": 1200,
    "cooldown_after_rate_limit_seconds": 21600
  },
  "daily_book": {
    "enabled": true,
    "schedule_local": "every 5 minutes",
    "max_new_books_per_run": 1,
    "rotation": [
      "interactive",
      "ordinary",
      "ordinary"
    ],
    "advance_rotation_only_after_verified_publication": true,
    "free_only": true,
    "paid_api_fallbacks": false,
    "cursor_fallback_requires_explicit_included_free_entitlement": true,
    "gemini_fallback_requires_explicit_included_free_entitlement": true,
    "defer_task_on_provider_quota_exhaustion": true,
    "continue_with_next_book_task_when_available": true,
    "text_provider": {
      "provider": "openrouter",
      "free_models_only": true,
      "model": "dots-studio/dots-3-note-preview:free",
      "secret_name": "OPENROUTER_API_KEY",
      "max_attempts": 8,
      "retry_delay_seconds": 45,
      "fallback_models": [
        "google/gemma-4-26b-a4b-it:free",
        "nvidia/nemotron-3.5-lightning:free",
        "openrouter/free"
      ],
      "json_mode_models": [
        "dots-studio/dots-3-note-preview:free",
        "google/gemma-4-26b-a4b-it:free"
      ],
      "reasoning_off_models": [
        "dots-studio/dots-3-note-preview:free"
      ],
      "secondary_provider_order": [
        "Gemini API only when explicitly verified free and enabled",
        "Cursor only when explicitly verified included-free and enabled",
        "otherwise preserve checkpoint and defer"
      ]
    },
    "image_providers": {
      "primary": "cloudflare",
      "fallback": "ovh",
      "require_complete_consistent_set": true,
      "max_internal_illustrations": 5,
      "ovh_delay_between_requests_seconds": 31,
      "ovh_retry_429_after_seconds": 65,
      "fallback_after_generation_limits": "openverse_cc0_then_wikimedia_commons_public_domain",
      "fallback_license_policy": {
        "commercial_use_required": true,
        "attribution_required": false,
        "accepted_licenses": [
          "CC0 1.0",
          "Public Domain"
        ],
        "require_machine_readable_license_metadata": true,
        "reject_unknown_or_restricted_licenses": true,
        "preserve_source_and_license_record": true,
        "public_domain_source": "Wikimedia Commons machine-readable metadata",
        "primary_search": "Openverse API filtered to CC0 and commercial use"
      }
    },
    "publication": {
      "inbox": "book-publications/inbox",
      "workflow": ".github/workflows/publish-book.yml",
      "verify_database_row": true,
      "verify_public_cover_and_illustrations": true,
      "notify_telegram_after_success": true,
      "never_overwrite_existing_books": true
    },
    "content_rules": {
      "reader_questions": {
        "min": 3,
        "max": 5
      },
      "age_appropriate_footnotes": true,
      "illustration_count_min": 1,
      "illustration_count_max": 5,
      "interactive_scene_count_max": 5,
      "interactive_one_image_per_scene": true,
      "no_unresolved_illustration_markers": true,
      "require_original_titles_and_plots": true,
      "preserve_author_bibles_and_series_continuity": true,
      "reading_length": {
        "minimum_reading_minutes": 180,
        "target_reading_minutes": 210,
        "minimum_words_all_ages": 36000,
        "target_words_all_ages": 39000,
        "ordinary_chapters": 12,
        "ordinary_minimum_words_per_chapter": 3000,
        "interactive_minimum_words_per_scene": 12000,
        "interactive_minimum_words_per_route": 36000,
        "generation_strategy": "12-chapter or 5-node outline, then sequential 900-1200 word fragments; checkpoint after every fragment; retry across explicitly free models and enabled free providers; reject incomplete or short books",
        "reject_short_books": true
      }
    },
    "on_failure": {
      "preserve_package_and_state": true,
      "do_not_advance_rotation": true,
      "except_when_task_is_explicitly_deferred_after_free_provider_quota_exhaustion": true,
      "do_not_publish_partial_book": true,
      "report_failure_to_telegram_admins": true
    },
    "excluded_titles": [
      "Последний день Вселенной"
    ],
    "excluded_projects": [
      {
        "title": "Последний день Вселенной",
        "slug": "last-day-of-universe",
        "status": "archived_for_external_continuation",
        "excluded_from_automatic_generation": true
      }
    ],
    "complete_deferred_task_before_starting_another": false
  },
  "management": {
    "source_of_truth": "book-publications/automation-config.json",
    "changes_may_be_requested_in_chat": true,
    "assistant_may_edit_repository_config_and_workflows": true,
    "require_successful_migration_test_before_disabling_chatgpt_automation": true,
    "last_updated_by": "ChatGPT - continue daily output using idle isolated worker while another book is cooling down"
  }
}
